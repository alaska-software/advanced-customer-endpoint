[PROJECT]
    TARGET_DIR = .\run
    Version = 3.0
    Project.xpj

[Project.xpj]
    business-logic\customer-core.dll
    service\advcustsvc.exe
    create-data.exe
    unit-test\runner.exe

[business-logic\customer-core.dll]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w /dll:dynamic
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           = /dll
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
    POST_BUILD           = copy customer-core.dll.config ..\unit-test
    POST_BUILD           = copy customer-core.dll.config ..\run
    DEPENDS_ON           = $(ASSETS_PATH)\configuration-manager@0.9
    DEPENDS_ON           = $(ASSETS_PATH)\jwt-helper@1.3
// $START-AUTODEPEND
    auth-service.obj
    customer-data-manager.obj
    customer-schema.obj
    wac-customer.obj
    wa-container.obj
// $STOP-AUTODEPEND
    auth-service.prg
    customer-core.dll.config
    customer-data-manager.prg
    customer-schema.prg
    wac-customer.prg
    wa-container.prg

[service\advcustsvc.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
    RUNPARAMETER         = -exe
    POST_BUILD           = copy advcustsvc.exe.config $(TARGET_PATH)
    DEPENDS_ON           = $(ASSETS_PATH)\jwt-helper@1.3
    DEPENDS_ON           = $(ASSETS_PATH)\configuration-manager@0.9
    DEPENDS_ON           = business-logic\customer-core.dll
    DEPENDS_ON           = $(ASSETS_PATH)\console-helper@0.14
    DEPENDS_ON           = $(ASSETS_PATH)\microservice-core@0.21
    DEPENDS_ON           = $(ASSETS_PATH)\rest-helper@0.21
// $START-AUTODEPEND
    advanced-customer-handler.obj
    adv-cust-svc-main.obj
    adv-cust-svc-microservice.obj
    auth-handler.obj
    auth-interceptor.obj
    cache-interceptor.obj
    logging-interceptor.obj
// $STOP-AUTODEPEND
    advanced-customer-handler.prg
    advcustsvc.exe.config
    adv-cust-svc-main.prg
    adv-cust-svc-microservice.prg
    auth-handler.oas3
    auth-handler.prg
    auth-interceptor.prg
    cache-interceptor.prg
    customer-handler.oas3
    logging-interceptor.prg
    version.arc

[create-data.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
    DEPENDS_ON           = business-logic\customer-core.dll
// $START-AUTODEPEND
    main.obj
// $STOP-AUTODEPEND
    main.prg
    readme.md

[unit-test\runner.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /q /w
    DEBUG                = yes
    GUI                  = yes
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    DEPENDS_ON           = 
    DEPENDS_ON           = business-logic\customer-core.dll
    TARGET_DIR           = .\
    DEPENDS_ON           = $(ASSETS_PATH)\jwt-helper@1.3
    DEPENDS_ON           = $(ASSETS_PATH)\rest-helper@0.21
    DEPENDS_ON           = $(ASSETS_PATH)\xpp-unit@0.101
    RunParameter         = -n:testSave_CreateSucceeds
// $START-AUTODEPEND
    auth-service-group.obj
    cust-data-mgr-group.obj
    rest-auth-group.obj
    rest-cust-group.obj
    runner.obj
// $STOP-AUTODEPEND
    auth-service-group.prg
    cust-data-mgr-group.prg
    customer-core.dll.config
    rest-auth-group.prg
    rest-cust-group.prg
    runner.prg


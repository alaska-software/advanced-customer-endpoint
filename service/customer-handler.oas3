{
  "openapi": "3.0.3",
  "info": {
    "title": "Customer REST API",
    "description": "Customer management API built with Xbase++ RestHandler. All endpoints require JWT Bearer token authentication. Requests are logged via LoggingInterceptor. Read operations (getAll, getById, getByName) benefit from response caching via CacheInterceptor.",
    "version": "1.0.0",
    "contact": {
      "name": "Alaska Software Inc.",
      "url": "https://www.alaska-software.com"
    },
    "license": {
      "name": "Copyright Alaska Software Inc. (c) 2026. All rights reserved."
    }
  },
  "servers": [
    {
      "url": "http://localhost:9000",
      "description": "Local development server"
    },
    {
      "url": "https://api1.alaska-software.net",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Customer",
      "description": "Customer management operations"
    }
  ],
  "paths": {
    "/customer/all": {
      "get": {
        "tags": ["Customer"],
        "summary": "Retrieve all customers",
        "description": "Returns a list of all customers wrapped in an envelope response. Response is cached by CacheInterceptor. Requires valid JWT Bearer token.",
        "operationId": "getAll",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all customers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates whether the request was successful"
                    },
                    "data": {
                      "type": "array",
                      "description": "Array of customer objects",
                      "items": {
                        "$ref": "#/components/schemas/Customer"
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "cust_id": "C00001",
                      "firstname": "Alice",
                      "lastname": "Johnson",
                      "email": "alice.johnson@example.com",
                      "phone": "+1-555-0101",
                      "street": "123 Main Street",
                      "city": "Springfield",
                      "state": "IL",
                      "zipcode": "62701",
                      "country": "USA",
                      "active": true,
                      "created": "2025-03-15",
                      "modified": "2025-03-15",
                      "notes": ""
                    },
                    {
                      "cust_id": "C00002",
                      "firstname": "Bob",
                      "lastname": "Smith",
                      "email": "bob.smith@example.com",
                      "phone": "+1-555-0102",
                      "street": "456 Oak Avenue",
                      "city": "Shelbyville",
                      "state": "TN",
                      "zipcode": "37160",
                      "country": "USA",
                      "active": true,
                      "created": "2025-04-20",
                      "modified": "2025-04-20",
                      "notes": ""
                    },
                    {
                      "cust_id": "C00003",
                      "firstname": "Carol",
                      "lastname": "White",
                      "email": "carol.white@example.com",
                      "phone": "+49-30-123456",
                      "street": "Berliner Str. 7",
                      "city": "Berlin",
                      "state": "",
                      "zipcode": "10115",
                      "country": "Germany",
                      "active": true,
                      "created": "2025-05-10",
                      "modified": "2025-05-10",
                      "notes": ""
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 401,
                    "message": "Unauthorized: Invalid or missing Bearer token"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 500,
                    "message": "Internal server error"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customer/{id}": {
      "get": {
        "tags": ["Customer"],
        "summary": "Retrieve a customer by ID",
        "description": "Returns a single customer identified by their cust_id, wrapped in an envelope response. Response is cached by CacheInterceptor. Requires valid JWT Bearer token.",
        "operationId": "getById",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the customer (maps to cust_id, up to 8 characters)",
            "schema": {
              "type": "string",
              "maxLength": 8
            },
            "example": "C00042"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the customer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Customer"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "cust_id": "C00042",
                    "firstname": "Alice",
                    "lastname": "Johnson",
                    "email": "alice.johnson@example.com",
                    "phone": "+1-555-0101",
                    "street": "123 Main Street",
                    "city": "Springfield",
                    "state": "IL",
                    "zipcode": "62701",
                    "country": "USA",
                    "active": true,
                    "created": "2025-03-15",
                    "modified": "2025-03-15",
                    "notes": ""
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 401,
                    "message": "Unauthorized: Invalid or missing Bearer token"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 404,
                    "message": "Customer not found"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 500,
                    "message": "Internal server error"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Customer"],
        "summary": "Save or update a customer by ID",
        "description": "Creates or updates a customer record. When the path id is empty, a new record is added. When the path id contains a valid cust_id, the matching record is updated. The cust_id field in the request body is always ignored — the customer identity is determined solely by the path parameter. Returns the saved customer data wrapped in an envelope response. Requires valid JWT Bearer token. This operation is NOT cached.",
        "operationId": "saveById",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": false,
            "description": "Pass an empty string to create a new customer record; pass an existing cust_id to update the matching record. The cust_id in the request body is always ignored.",
            "schema": {
              "type": "string",
              "maxLength": 8
            },
            "example": "C00042"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Customer data to save or update. The cust_id field in the body is always ignored; the customer identity is determined solely by the path id parameter.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerInput"
              },
              "example": {
                "firstname": "Alice",
                "lastname": "Johnson",
                "email": "alice.johnson@example.com",
                "phone": "+1-555-0101",
                "street": "123 Main Street",
                "city": "Springfield",
                "state": "IL",
                "zipcode": "62701",
                "country": "USA",
                "active": true,
                "notes": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer successfully saved or updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Customer"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "cust_id": "C00042",
                    "firstname": "Alice",
                    "lastname": "Johnson",
                    "email": "alice.johnson@example.com",
                    "phone": "+1-555-0101",
                    "street": "123 Main Street",
                    "city": "Springfield",
                    "state": "IL",
                    "zipcode": "62701",
                    "country": "USA",
                    "active": true,
                    "created": "2025-03-15",
                    "modified": "2025-06-01",
                    "notes": ""
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 401,
                    "message": "Unauthorized: Invalid or missing Bearer token"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Failed to save customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 500,
                    "message": "Failed to save customer"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Customer"],
        "summary": "Delete a customer by ID",
        "description": "Permanently deletes the customer identified by the cust_id. Returns a boolean result wrapped in an envelope response. Requires valid JWT Bearer token. This operation is NOT cached.",
        "operationId": "deleteById",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier (cust_id, up to 8 characters) of the customer to delete",
            "schema": {
              "type": "string",
              "maxLength": 8
            },
            "example": "C00042"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer successfully deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "boolean",
                      "description": "True if the customer was successfully deleted"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 401,
                    "message": "Unauthorized: Invalid or missing Bearer token"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 404,
                    "message": "Customer not found"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 500,
                    "message": "Internal server error"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customer/search/{name}": {
      "get": {
        "tags": ["Customer"],
        "summary": "Search customers by name",
        "description": "Returns a list of customers matching the provided name fragment. The search is performed against the index key Upper(lastname + firstname), so the name parameter is automatically uppercased and matched from the start of the combined last+first name. Response is cached by CacheInterceptor. Requires valid JWT Bearer token.",
        "operationId": "getByName",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Name fragment to search for. Matched case-insensitively against the index key Upper(lastname + firstname).",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "JOHNSON"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved matching customers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "description": "Array of matching customer objects",
                      "items": {
                        "$ref": "#/components/schemas/Customer"
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "cust_id": "C00042",
                      "firstname": "Alice",
                      "lastname": "Johnson",
                      "email": "alice.johnson@example.com",
                      "phone": "+1-555-0101",
                      "street": "123 Main Street",
                      "city": "Springfield",
                      "state": "IL",
                      "zipcode": "62701",
                      "country": "USA",
                      "active": true,
                      "created": "2025-03-15",
                      "modified": "2025-03-15",
                      "notes": ""
                    },
                    {
                      "cust_id": "C00087",
                      "firstname": "Mark",
                      "lastname": "Johnson",
                      "email": "mark.johnson@example.com",
                      "phone": "+1-555-0199",
                      "street": "789 Elm Street",
                      "city": "Capital City",
                      "state": "TX",
                      "zipcode": "78701",
                      "country": "USA",
                      "active": true,
                      "created": "2025-06-01",
                      "modified": "2025-06-01",
                      "notes": ""
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 401,
                    "message": "Unauthorized: Invalid or missing Bearer token"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No customers found matching the provided name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "description": "Empty array when no customers match",
                      "items": {
                        "type": "object"
                      }
                    },
                    "error": {
                      "$ref": "#/components/schemas/ErrorDetail"
                    }
                  }
                },
                "example": {
                  "success": false,
                  "data": [],
                  "error": {
                    "code": 404,
                    "message": "No customers found matching: JOHNSON"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": 500,
                    "message": "Internal server error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Customer": {
        "type": "object",
        "description": "Customer record as stored in and returned from the customer.dbf workarea",
        "properties": {
          "cust_id": {
            "type": "string",
            "maxLength": 8,
            "description": "Unique customer identifier (C,8 character field)"
          },
          "firstname": {
            "type": "string",
            "maxLength": 50,
            "description": "First name of the customer"
          },
          "lastname": {
            "type": "string",
            "maxLength": 50,
            "description": "Last name of the customer"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "description": "Customer email address"
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "description": "Customer phone number"
          },
          "street": {
            "type": "string",
            "maxLength": 100,
            "description": "Customer street address"
          },
          "city": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer city"
          },
          "state": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer state or region"
          },
          "zipcode": {
            "type": "string",
            "maxLength": 10,
            "description": "Customer ZIP or postal code"
          },
          "country": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer country"
          },
          "active": {
            "type": "boolean",
            "description": "Indicates whether the customer account is active"
          },
          "created": {
            "type": "string",
            "format": "date",
            "description": "Date when the customer record was created (set automatically on first save)"
          },
          "modified": {
            "type": "string",
            "format": "date",
            "description": "Date when the customer record was last modified (updated on every save)"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes about the customer (memo field)"
          }
        }
      },
      "CustomerInput": {
        "type": "object",
        "description": "Customer data submitted for create or update operations. The cust_id is never part of the body — it is always taken from the path parameter.",
        "required": ["firstname", "lastname", "email"],
        "properties": {
          "firstname": {
            "type": "string",
            "maxLength": 50,
            "description": "First name of the customer"
          },
          "lastname": {
            "type": "string",
            "maxLength": 50,
            "description": "Last name of the customer"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "description": "Customer email address"
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "description": "Customer phone number"
          },
          "street": {
            "type": "string",
            "maxLength": 100,
            "description": "Customer street address"
          },
          "city": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer city"
          },
          "state": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer state or region"
          },
          "zipcode": {
            "type": "string",
            "maxLength": 10,
            "description": "Customer ZIP or postal code"
          },
          "country": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer country"
          },
          "active": {
            "type": "boolean",
            "description": "Indicates whether the customer account is active"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes about the customer"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token required. Validated by AuthInterceptor on every request. Include the token in the Authorization header as: Authorization: Bearer <token>"
      }
    }
  }
}

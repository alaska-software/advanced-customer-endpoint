{
  "openapi": "3.0.3",
  "info": {
    "title": "Customer REST API",
    "description": "Customer management API built with Xbase++ RestHandler. All endpoints require JWT Bearer token authentication. Requests are logged via LoggingInterceptor. Read operations (getAll, getById, getByName) benefit from response caching via CacheInterceptor.",
    "version": "1.0.0",
    "contact": {
      "name": "Alaska Software Inc.",
      "url": "https://www.alaska-software.com"
    },
    "license": {
      "name": "Copyright Alaska Software Inc. (c) 2026. All rights reserved."
    }
  },
  "servers": [
    {
      "url": "http://localhost:9000",
      "description": "Local development server"
    },
    {
      "url": "https://api1.alaska-software.net",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Customer",
      "description": "Customer management operations"
    }
  ],
  "paths": {
    "/customer/all": {
      "get": {
        "tags": ["Customer"],
        "summary": "Retrieve all customers",
        "description": "Returns a list of all customers wrapped in an envelope response. Response is cached by CacheInterceptor. Requires valid JWT Bearer token.",
        "operationId": "getAll",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all customers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "array",
                      "description": "Array of customer objects",
                      "items": {
                        "$ref": "#/components/schemas/Customer"
                      }
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "description": "Error message; null on success",
                      "example": null
                    }
                  }
                },
                "example": {
                  "result": [
                    {
                      "CUST_ID": "ALBE0010",
                      "FIRSTNAME": "Alice",
                      "LASTNAME": "Albertson",
                      "EMAIL": "alice.albertson@example.com",
                      "PHONE": "+1-555-0101",
                      "STREET": "123 Main Street",
                      "CITY": "Springfield",
                      "STATE": "IL",
                      "ZIPCODE": "62701",
                      "COUNTRY": "USA",
                      "ACTIVE": true,
                      "CREATED": "2025-03-15",
                      "MODIFIED": "2025-03-15",
                      "NOTES": ""
                    },
                    {
                      "CUST_ID": "JOHN0009",
                      "FIRSTNAME": "Alice",
                      "LASTNAME": "Johnson",
                      "EMAIL": "alice.johnson@example.com",
                      "PHONE": "+1-555-0101",
                      "STREET": "123 Main Street",
                      "CITY": "Springfield",
                      "STATE": "IL",
                      "ZIPCODE": "62701",
                      "COUNTRY": "USA",
                      "ACTIVE": true,
                      "CREATED": "2025-04-20",
                      "MODIFIED": "2025-04-20",
                      "NOTES": ""
                    }
                  ],
                  "error": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Unauthorized: Invalid or missing Bearer token"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/customer": {
      "post": {
        "tags": ["Customer"],
        "summary": "Create a new customer",
        "description": "Creates a new customer record. The CUST_ID is auto-generated from the first 4 characters of lastname+city (uppercased) followed by the next record number. Returns the created customer data wrapped in an envelope response. Requires valid JWT Bearer token. This operation is NOT cached.",
        "operationId": "create",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Customer data for the new record. The cust_id is always auto-generated and must not be supplied.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerInput"
              },
              "example": {
                "firstname": "Alice",
                "lastname": "Johnson",
                "email": "alice.johnson@example.com",
                "phone": "+1-555-0101",
                "street": "123 Main Street",
                "city": "Springfield",
                "state": "IL",
                "zipcode": "62701",
                "country": "USA",
                "active": true,
                "notes": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/Customer"
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "description": "Error message; null on success",
                      "example": null
                    }
                  }
                },
                "example": {
                  "result": {
                    "CUST_ID": "JOHN0042",
                    "FIRSTNAME": "Alice",
                    "LASTNAME": "Johnson",
                    "EMAIL": "alice.johnson@example.com",
                    "PHONE": "+1-555-0101",
                    "STREET": "123 Main Street",
                    "CITY": "Springfield",
                    "STATE": "IL",
                    "ZIPCODE": "62701",
                    "COUNTRY": "USA",
                    "ACTIVE": true,
                    "CREATED": "2025-06-01",
                    "MODIFIED": "2025-06-01",
                    "NOTES": ""
                  },
                  "error": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Unauthorized: Invalid or missing Bearer token"
                }
              }
            }
          },
          "500": {
            "description": "Failed to create customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Failed to create customer"
                }
              }
            }
          }
        }
      }
    },
    "/customer/{id}": {
      "get": {
        "tags": ["Customer"],
        "summary": "Retrieve a customer by ID",
        "description": "Returns a single customer identified by their CUST_ID, wrapped in an envelope response. Response is cached by CacheInterceptor. Requires valid JWT Bearer token.",
        "operationId": "getById",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the customer (maps to CUST_ID, up to 8 characters)",
            "schema": {
              "type": "string",
              "maxLength": 8
            },
            "example": "CUST0014"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the customer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/Customer"
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "description": "Error message; null on success",
                      "example": null
                    }
                  }
                },
                "example": {
                  "result": {
                    "CUST_ID": "CUST0014",
                    "FIRSTNAME": "Test",
                    "LASTNAME": "Customer",
                    "EMAIL": "test.customer@rest.test",
                    "PHONE": "555-0199",
                    "STREET": "1 Test Lane",
                    "CITY": "Testville",
                    "STATE": "TX",
                    "ZIPCODE": "10001",
                    "COUNTRY": "US",
                    "ACTIVE": true,
                    "CREATED": "2026-07-04",
                    "MODIFIED": "2026-07-04",
                    "NOTES": ""
                  },
                  "error": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Unauthorized: Invalid or missing Bearer token"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Customer not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Customer"],
        "summary": "Update a customer by ID",
        "description": "Updates an existing customer record identified by the path id. The CUST_ID field in the request body is always ignored — the customer identity is determined solely by the path parameter. Returns the updated customer data wrapped in an envelope response. Requires valid JWT Bearer token. This operation is NOT cached.",
        "operationId": "updateById",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier (CUST_ID, up to 8 characters) of the customer to update. The cust_id in the request body is always ignored.",
            "schema": {
              "type": "string",
              "maxLength": 8
            },
            "example": "CUST0014"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Customer data to update. The cust_id field in the body is always ignored; the customer identity is determined solely by the path id parameter.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerInput"
              },
              "example": {
                "firstname": "Test",
                "lastname": "Customer",
                "email": "test.customer@rest.test",
                "phone": "555-0199",
                "street": "1 Test Lane",
                "city": "Testville",
                "state": "TX",
                "zipcode": "10001",
                "country": "US",
                "active": true,
                "notes": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/Customer"
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "description": "Error message; null on success",
                      "example": null
                    }
                  }
                },
                "example": {
                  "result": {
                    "CUST_ID": "CUST0014",
                    "FIRSTNAME": "Test",
                    "LASTNAME": "Customer",
                    "EMAIL": "test.customer@rest.test",
                    "PHONE": "555-0199",
                    "STREET": "1 Test Lane",
                    "CITY": "Testville",
                    "STATE": "TX",
                    "ZIPCODE": "10001",
                    "COUNTRY": "US",
                    "ACTIVE": true,
                    "CREATED": "2026-07-04",
                    "MODIFIED": "2026-07-05",
                    "NOTES": ""
                  },
                  "error": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Unauthorized: Invalid or missing Bearer token"
                }
              }
            }
          },
          "500": {
            "description": "Failed to update customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Failed to save customer"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Customer"],
        "summary": "Delete a customer by ID",
        "description": "Permanently deletes the customer identified by the CUST_ID. Returns a boolean result wrapped in an envelope response. Requires valid JWT Bearer token. This operation is NOT cached.",
        "operationId": "deleteById",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier (CUST_ID, up to 8 characters) of the customer to delete",
            "schema": {
              "type": "string",
              "maxLength": 8
            },
            "example": "CUST0014"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer successfully deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "boolean",
                      "description": "True if the customer was successfully deleted"
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "description": "Error message; null on success",
                      "example": null
                    }
                  }
                },
                "example": {
                  "result": true,
                  "error": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Unauthorized: Invalid or missing Bearer token"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Customer not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/customer/search/{name}": {
      "get": {
        "tags": ["Customer"],
        "summary": "Search customers by name",
        "description": "Returns a list of customers matching the provided name fragment. The search is performed against the index key Upper(lastname + firstname), so the name parameter is automatically uppercased and matched from the start of the combined last+first name. Response is cached by CacheInterceptor. Requires valid JWT Bearer token.",
        "operationId": "getByName",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Name fragment to search for. Matched case-insensitively against the index key Upper(lastname + firstname).",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "JOHNSON"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved matching customers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "array",
                      "description": "Array of matching customer objects",
                      "items": {
                        "$ref": "#/components/schemas/Customer"
                      }
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "description": "Error message; null on success",
                      "example": null
                    }
                  }
                },
                "example": {
                  "result": [
                    {
                      "CUST_ID": "JOHN0009",
                      "FIRSTNAME": "Alice",
                      "LASTNAME": "Johnson",
                      "EMAIL": "alice.johnson@example.com",
                      "PHONE": "+1-555-0101",
                      "STREET": "123 Main Street",
                      "CITY": "Springfield",
                      "STATE": "IL",
                      "ZIPCODE": "62701",
                      "COUNTRY": "USA",
                      "ACTIVE": true,
                      "CREATED": "2025-03-15",
                      "MODIFIED": "2025-03-15",
                      "NOTES": ""
                    }
                  ],
                  "error": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT Bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Unauthorized: Invalid or missing Bearer token"
                }
              }
            }
          },
          "404": {
            "description": "No customers found matching the provided name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "No customers found matching: JOHNSON"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "result": null,
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Customer": {
        "type": "object",
        "description": "Customer record as returned from the customer.dbf workarea. Field names are uppercase as serialised by the DBF engine.",
        "properties": {
          "CUST_ID": {
            "type": "string",
            "maxLength": 8,
            "description": "Unique customer identifier (C,8 character field)"
          },
          "FIRSTNAME": {
            "type": "string",
            "maxLength": 50,
            "description": "First name of the customer"
          },
          "LASTNAME": {
            "type": "string",
            "maxLength": 50,
            "description": "Last name of the customer"
          },
          "EMAIL": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "description": "Customer email address"
          },
          "PHONE": {
            "type": "string",
            "maxLength": 20,
            "description": "Customer phone number"
          },
          "STREET": {
            "type": "string",
            "maxLength": 100,
            "description": "Customer street address"
          },
          "CITY": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer city"
          },
          "STATE": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer state or region"
          },
          "ZIPCODE": {
            "type": "string",
            "maxLength": 10,
            "description": "Customer ZIP or postal code"
          },
          "COUNTRY": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer country"
          },
          "ACTIVE": {
            "type": "boolean",
            "description": "Indicates whether the customer account is active"
          },
          "CREATED": {
            "type": "string",
            "format": "date",
            "description": "Date when the customer record was created (set automatically on first save)"
          },
          "MODIFIED": {
            "type": "string",
            "format": "date",
            "description": "Date when the customer record was last modified (updated on every save)"
          },
          "NOTES": {
            "type": "string",
            "description": "Additional notes about the customer (memo field)"
          }
        }
      },
      "CustomerInput": {
        "type": "object",
        "description": "Customer data submitted for create or update operations. Field names are lowercase as expected by the handler. The cust_id is never part of the request body — for POST it is auto-generated; for PUT it is taken from the path parameter.",
        "required": ["firstname", "lastname", "email"],
        "properties": {
          "firstname": {
            "type": "string",
            "maxLength": 50,
            "description": "First name of the customer"
          },
          "lastname": {
            "type": "string",
            "maxLength": 50,
            "description": "Last name of the customer"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "description": "Customer email address"
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "description": "Customer phone number"
          },
          "street": {
            "type": "string",
            "maxLength": 100,
            "description": "Customer street address"
          },
          "city": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer city"
          },
          "state": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer state or region"
          },
          "zipcode": {
            "type": "string",
            "maxLength": 10,
            "description": "Customer ZIP or postal code"
          },
          "country": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer country"
          },
          "active": {
            "type": "boolean",
            "description": "Indicates whether the customer account is active"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes about the customer"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error envelope returned on failure",
        "properties": {
          "result": {
            "nullable": true,
            "description": "Always null when an error is present",
            "example": null
          },
          "error": {
            "type": "string",
            "description": "Human-readable error message describing what went wrong"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token required. Validated by AuthInterceptor on every request. Include the token in the Authorization header as: Authorization: Bearer <token>"
      }
    }
  }
}
